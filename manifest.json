{
  "manifest_version": 3,
  "name": "Browser Screen Time",
  "version": "1.0.0",
  "description": "Limit time on distracting websites, styled after iPhone Screen Time.",
  "action": {
    "default_popup": "dashboard/index.html",
    "default_title": "Browser Screen Time",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
